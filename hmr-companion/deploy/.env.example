# HMR Companion — VPS (Docker + Caddy)
# Copia questo file in `.env` accanto a docker-compose.yml e imposta HMR_DOMAIN.

# Dominio pubblico (DNS A/AAAA → IP del VPS). Caddy ottiene Let's Encrypt automaticamente.
HMR_DOMAIN=hmr.example.com

# Token per POST /api/admin/ingest (obbligatorio in produzione)
INGEST_TOKEN=change-me-strong

# Auth via email (magic link) — solo email presenti nella whitelist.
HMR_ALLOWED_EMAILS=agostino.lurani@gmail.com
HMR_APP_URL=https://hmr.example.com
# RESEND_API_KEY=re_xxxxx
# HMR_AUTH_FROM_EMAIL=HMR Companion <auth@tuodominio.com>

# Opzionale: Google Maps / Mapillary (come in .env.example)
# GOOGLE_MAPS_API_KEY=
# MAPILLARY_ACCESS_TOKEN=
