# HMR Companion — variabili per `docker compose` (cartella deploy/)
# Copia in `.env` sul server: cp .env.example .env
# Non committare `.env` (contiene segreti).

# --- Obbligatorie (Compose fallisce senza) ---
HMR_DOMAIN=hmr.example.com
INGEST_TOKEN=genera-un-token-lungo-e-casuale

# --- Build immagine (client Next.js, Windy meteo) ---
NEXT_PUBLIC_WINDY_API_KEY=

# --- Routing v2 (OpenRouteService) ---
OPENROUTESERVICE_API_KEY=

# --- Geocoding / ricerca luoghi (Nominatim OSM) ---
NOMINATIM_USER_AGENT=HMRCompanion/1.0 (https://hmr.example.com; contact: you@example.com)

# --- Opzionali: media e mappe ---
# Base map vettoriale OpenMapTiles (MapTiler Cloud) — esposta al client Next.js
NEXT_PUBLIC_MAPTILER_KEY=
GOOGLE_MAPS_API_KEY=
MAPILLARY_ACCESS_TOKEN=

# --- Opzionali: AI (riassunti gara / POI) ---
ANTHROPIC_API_KEY=
HMR_OVERVIEW_MODEL=
HMR_POI_SUMMARY_MODEL=
