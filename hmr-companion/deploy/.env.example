# HMR Companion — VPS (Docker + Caddy)
# Copia in `.env` accanto a docker-compose.yml (solo sul server; non committare).
#
# Il servizio `hmr` carica tutto questo file con `env_file: .env` — niente duplicati
# nel docker-compose.yml per INGEST / Google / Mapillary / Windy.

# Obbligatorio: dominio (anche per Caddy / Let's Encrypt)
HMR_DOMAIN=hmr.example.com

# Obbligatorio in produzione: POST /api/admin/ingest
INGEST_TOKEN=change-me-strong

# Opzionale
# GOOGLE_MAPS_API_KEY=
# MAPILLARY_ACCESS_TOKEN=

# Opzionale ma necessario per la mappa Meteo+traccia (Windy Map Forecast al build)
# NEXT_PUBLIC_WINDY_API_KEY=
