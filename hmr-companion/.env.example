# Token per proteggere POST /api/admin/ingest (rigenerare se condiviso)
INGEST_TOKEN=change-me

# Login: utenti e password fissi nel codice (`src/lib/auth.ts`), nessuna env auth.

# Google Maps Platform — Street View Metadata (server-side). Abilita "Street View Static API"
# (include i metadati) nel progetto Cloud e restringi la chiave a IP/server.
# Senza chiave, GET /api/track/:id/street-view risponde con elenco vuoto e messaggio.
# GOOGLE_MAPS_API_KEY=

# Mapillary Graph API (opzionale). Client token da https://www.mapillary.com/dashboard/developers
# Passato come access_token sulle richieste Graph. Senza token: items: [] e configured: false.
# MAPILLARY_ACCESS_TOKEN=

# Percorso del DB SQLite (default: data/hmr.db)
# HMR_DB_PATH=data/hmr.db

# Nome GPX in data/ usato dal comando `npm run ingest`
# HMR_GPX_FILENAME=Hellenic_Mountain_Race_2026.gpx

# Identificativo User-Agent per Overpass (consigliato in prod)
# HMR_OVERPASS_UA=hmr-companion/0.1 (your-email@example.com)

# Lista mirror Overpass separati da virgola (override default)
# HMR_OVERPASS_MIRROR=https://overpass-api.de/api/interpreter,https://lz4.overpass-api.de/api/interpreter

# Timeout (ms) per singola call a un mirror Overpass (10_000..180_000)
# HMR_OVERPASS_TIMEOUT_MS=55000

# Anthropic — overview testuale in GET /api/track/:id/race-brief?withOverview=1 (opzionale).
# Senza chiave: overview resta il testo deterministico da JSON.
# ANTHROPIC_API_KEY=
# Modello per sintesi gara (default: claude-3-5-haiku-20241022). Opzionale: ANTHROPIC_MODEL nel monorepo.
# HMR_OVERVIEW_MODEL=claude-3-5-haiku-20241022

# Snapshot tuning (usati da scripts/snapshot-pois.ts)
# HMR_SNAPSHOT_GRID_COLS=4     # colonne della griglia bbox (celle = cols*rows)
# HMR_SNAPSHOT_GRID_ROWS=5     # righe della griglia bbox
# HMR_SNAPSHOT_PAUSE_MS=600    # pausa tra celle consecutive per worker
# HMR_SNAPSHOT_CONCURRENCY=2   # celle in parallelo (Overpass pubblico ammette 2)
# HMR_SNAPSHOT_RETRIES=2       # tentativi prima dello split adattivo
# HMR_SNAPSHOT_SPLIT_DEPTH=4   # profondità massima dello split (1 cella → 4^depth sub-celle)
# HMR_SNAPSHOT_BBOX_PAD=0.03   # padding (gradi) intorno alla bbox della traccia
